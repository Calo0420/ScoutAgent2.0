# ── Deploy Mode ───────────────────────────────────────────────────────────────
# claude       = direct Anthropic API (fast, default)
# bedrock      = AWS Bedrock (stays in client AWS account, compliance-friendly)
# ollama       = local LLM server (air-gap / fully on-prem, requires GPU server)
# venice       = Venice AI via Agent Zero key (OpenAI-compat, open-source models)
# azure_openai = Azure OpenAI Service (stays in client Azure tenant)
DEPLOY_MODE=claude

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to true to run with mock data — no real infrastructure needed
# Use this for demos, testing, and development
DEMO_MODE=false

# ── Anthropic API (required when DEPLOY_MODE=claude) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── AWS Bedrock (required when DEPLOY_MODE=bedrock) ───────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# ── Ollama (required when DEPLOY_MODE=ollama) ─────────────────────────────────
# Point this at the GPU server running Ollama
# Minimum recommended: NVIDIA A10 24GB VRAM, Llama 3 8B model
OLLAMA_BASE_URL=http://gpu-server.internal:11434/v1
OLLAMA_MODEL=llama3

# ── Venice AI via Agent Zero (required when DEPLOY_MODE=venice) ───────────────
# Get your key from agent-zero.ai — OpenAI-compat API, open-source models
VENICE_API_KEY=sk-a0-...
VENICE_MODEL=llama-3.3-70b

# ── Azure OpenAI (required when DEPLOY_MODE=azure_openai) ──────────────────
# Enterprise Azure OpenAI endpoint — data stays in client Azure tenant
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# -- Gatekeeper AI Trust Gateway --
# Set GATEKEEPER_ENABLED=true to require human approval before each scan
# Point GATEKEEPER_URL at your Gatekeeper instance
GATEKEEPER_ENABLED=true
GATEKEEPER_URL=http://localhost:8001
